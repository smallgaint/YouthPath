# ============================================================
# YouthPath 환경변수 샘플
# 사용법: 이 파일을 복사해 `.env` 로 만들고 값을 채우세요.
#   cp .env.sample .env
# `.env` 는 .gitignore 에 의해 커밋되지 않습니다. (절대 키를 커밋하지 마세요)
# ============================================================

# --- Policy Agent : 온통청년 정책 API ---
# 발급: https://www.youthcenter.go.kr (Open API 신청)
ONTONG_API_KEY=발급받은_온통청년_API_KEY

# --- Job Agent : 공공데이터포털 채용공고 API ---
# 발급: https://www.data.go.kr (채용정보 통합 API)
PUBLIC_RECRUIT_API_URL=https://apis.data.go.kr/1051000/recruitment
PUBLIC_RECRUIT_SERVICE_KEY=발급받은_공공데이터_서비스키
# (선택) 위 키가 없을 때 대체로 읽는 변수들
DATA_GO_KR_SERVICE_KEY=
SERVICE_KEY=

# --- Job Agent : 워크넷 authKey (선택, 워크넷 실연동 시) ---
WORKNET_API_KEY=
WORKNET_RECRUIT_API_KEY=
WORKNET_JOB_INFO_API_KEY=
WORKNET_SME_API_KEY=
WORKNET_COMMON_CODE_API_KEY=
WORKNET_OCCUPATION_API_KEY=
WORKNET_TIMEOUT=6

# --- Resume Agent : 기업 공시(DART) + 뉴스(NAVER) ---
# DART 발급: https://opendart.fss.or.kr
DART_API_KEY=발급받은_DART_API_KEY
# NAVER 검색 API 발급: https://developers.naver.com
NAVER_CLIENT_ID=발급받은_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=발급받은_NAVER_CLIENT_SECRET

# --- LLM Provider : LUXIA (없으면 자동으로 Mock 폴백) ---
YOUTHPATH_LLM_PROVIDER=luxia
LUXIA_API_URL=https://bridge.luxiacloud.com/luxia/v1/chat
LUXIA_API_KEY=발급받은_LUXIA_API_KEY
LUXIA_MODEL=luxia3-llm-32b-0731
LUXIA_TIMEOUT=60
LUXIA_REQUEST_FORMAT=openai
LUXIA_AUTH_HEADER=apikey
LUXIA_AUTH_SCHEME=
LUXIA_INCLUDE_GENERATION_PARAMS=false
# LUXIA 장애 시 Mock 답변으로 폴백 (true 권장)
LUXIA_FALLBACK_TO_MOCK=true

# (대안) OpenAI 사용 시
# OPENAI_API_KEY=

# --- RAG (Chroma) : Resume 기업 공시 인덱스 ---
# Resume 에이전트가 사용할 기업 공시 인덱스 경로(절대경로 권장)
CHROMA_DB_PATH=/절대경로/YouthPath-A/chroma_db
CHROMA_COLLECTION_NAME=companies
