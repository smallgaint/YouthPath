						<p class="s1_r">{{:maxFileCnt}}개</p>
	                    <p class="b1_sb">등록 가능 파일</p>
						<p class="s1_r">{{:athflFnen2}}</p>
						<button type="button" class="ico16_delete tooltip_close"><span class="blind">닫기</span></button>
	                </div>
	            </div>
	            {{/if}}

				{{if essYn == 'Y' }}
					<span class="essential" ><i class="blind">필수</i></span>
				{{/if}}
				</p>
			</div>
			{{if smplAthflDownloadUrl != '' && smplAthflDownloadUrl != undefinded }}
