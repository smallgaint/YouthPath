			{{if mdtEvdcPaprId != '' && mdtEvdcPaprId != undefinded }}
			<div class="flup_box">
                <div class="flup_box_txt">공공 마이데이터를 통해 민원신청에 필요한 각종 서식을 제출할 수 있습니다.</div>
                <div class="flup_box_flex">
                    <button type="button" class="btn small type02" name="viewMyData_{{:athflMdulId}}_{{:atchPaprId}}" id="viewMyData_{{:athflMdulId}}_{{:atchPaprId}}" data-value="{{:mdtEvdcPaprId}}" data-bndlfomtcd="{{:bndlFomtCn}}" data-mdt-gdsn="{{:mdtGdsn}}" data-mdt-gods-tycd="{{:mdtGodsTycd}}" title="가져올 수 있는 본인정보 보기">가져올 수 있는 본인정보 보기</button>
                    <button type="button" class="btn small type01" name="addMyData_{{:athflMdulId}}_{{:atchPaprId}}" id="addMyData_{{:athflMdulId}}_{{:atchPaprId}}" data-value="{{:mdtEvdcPaprId}}" data-bndlfomtcd="{{:bndlFomtCn}}" data-mdt-gdsn="{{:mdtGdsn}}" data-mdt-gods-tycd="{{:mdtGodsTycd}}" title="공공 마이데이터 가져오기">공공마이데이터 가져오기</button>
                    <button type="button" class="btn small type02" name="chkMyData_{{:mdtEvdcPaprId}}_{{:atchPaprId}}" id="chkMyData_{{:athflMdulId}}_{{:atchPaprId}}" data-value="{{:mdtEvdcPaprId}}" data-mdtgdsn="{{:mdtGdsn}}" data-mdtgodstycd="{{:mdtGodsTycd}}" title="제출서류 보기" style="display:none">제출서류보기</button>
                </div>
            </div>
            {{/if}}
            {{if elctProfDocKndCd != '' && elctProfDocKndCd != undefinded }}
            <!--
            <div class="flup_box">
                <div class="flup_box_txt">행정·공공기관이 발급하는 전자문서 형태의 증명서를 민원신청 시 제출할 수 있습니다.</div>
                <div class="flup_box_flex">
                    <button type="button" class="btn small type02">전자증명신청</button>
                    <button type="button" class="btn small type02">전자증명제출</button>
                </div>
            </div>
            -->
            {{/if}}
		</div>
	</div>
`);

