$.templates("filePapr", `
	<div id="filePapr_{{:athflMdulId}}_{{:atchPaprId}}" class="prfd_data" data-etc="{{:etc}}" data-athfl-stup-secd="{{:athflStupSecd}}">
		<div class="atfl_data">
			<div class="atfl_data_r">
				<p class="atfl_data_tit" id="paprTitle" data-title="{{:atchPaprCn}}">{{:idx}}. {{:atchPaprCn}}

				{{if profile != 'prod' }}
				({{:atchPaprId}})
				{{/if}}

				{{if athflStupSecd == 'ERT02'}}
				<div class="box_tooltip type2 bottom">
	                <button type="button" class="btn_help dis vttop" aria-expanded="true"><span class="blind">등록 가능 파일</span></button>
	                <div class="box_help-data w_large">
	                	<p class="b1_sb">첨부파일 용량</p>
