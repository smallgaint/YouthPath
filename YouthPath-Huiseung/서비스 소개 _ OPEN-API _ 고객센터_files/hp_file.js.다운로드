				var target = e.delegatedEvent.delegateTarget;
				$(target).removeClass("fileover");
			});

			var fileError = false;
		    $("#"+"fileupload_dummy_"+tempId).bind('fileuploadprocessfail', function (e, data) {
				fileError = true;
		    });

		    $("#"+"fileupload_dummy_"+tempId).bind('fileuploadprocessstop', function (e, data) {
				if(!fileError){
