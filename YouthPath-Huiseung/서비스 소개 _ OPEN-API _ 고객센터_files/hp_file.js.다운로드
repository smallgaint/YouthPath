/**
 * 파일 컴포넌트 동기화 및 파일 갯수 계산
 */
ComFileLib.fn_fileSync = function(){
	$("[id=div_fileArea]").each(function(){
		var _this = $(this);

	    var cnt = _this.find("[id^='fileContainer_'] ul li").length;
	    _this.find("#fileTotCnt").text(cnt);

		if(cnt > 0){
			_this.find("[id^='fileContainer_']").find("p").hide();
			_this.find("[id^='fileContainer_']").find("ul").show();
			_this.find("#btn_deleteAll").removeAttr("disabled");
		}else{
			_this.find("[id^='fileContainer_']").find("p").show();
			_this.find("[id^='fileContainer_']").find("ul").hide();
			_this.find("#btn_deleteAll").attr("disabled", "true");
		}


		var totFileSize = 0;
		_this.find("[id^='fileContainer_'] ul li [id=flsz]").each(function(){
			totFileSize += $(this).data("flsz");
		});

		_this.find("#fileTotSize").data("flsz", totFileSize).text($.blueimp.fileupload.prototype._formatFileSize(totFileSize));

		// 파일 컴포넌트의 옵션값 수정
		var fileUploadId = _this.find("[id^='fileContainer_']").attr("id").replace("fileContainer_", "fileupload_dummy_");
		$("#"+fileUploadId).fileupload("option", "totFileSize" , totFileSize);


	    //var _option = $("#"+"fileupload_dummy_"+_id).fileupload("option");
	    // 파일 컴포넌트 파일 갯수 및 크기 제한 동기화
	    /*
		$("#"+"fileupload_dummy_"+_id).fileupload("option", "maxNumberOfFiles" , _option.limitFileCnt - myDataCnt);
		*/

		_this.find("ul li").each(function(idx){
			$(this).find(".fileIndex").text(idx+1);
		})


		/* 첨부파일 부른 후 JSFileWidth() 실행해주세요. */
		_this.find('.box_file_wrap ').find('.clr_blue').each(function(index, elm) {
			if(index === _this.find('.box_file_wrap ').find('.clr_blue').length -1) {
				var gWidth = $(elm).outerWidth(true);
				var exitValue = parseFloat($(elm).css('max-width'));
				if(exitValue > 10) return false;
		        $(elm).css('max-width', '10px');
		        var eW = $(elm).closest('.box_file_flex').outerWidth(true);
		        var cM = $(elm).siblings('.mb').outerWidth(true) || 0;

				document.fonts.ready.then(function() {
					requestAnimationFrame(function() {
						var eTag1 = Math.floor($(elm)[0].getBoundingClientRect().left);
						var eTag2 = Math.floor($(elm).closest('.box_file_flex')[0].getBoundingClientRect().left);
						var eTag = eTag1 - eTag2;
						var elmWidth = eW - eTag - cM;

						$(elm).css('max-width', '');

						if(Math.floor(gWidth+cM+eTag) >= eW) {
							$(elm).css('max-width', elmWidth - 20);
						}
					})
				});
			}
		});
	});

}

