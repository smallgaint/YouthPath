						ui.dimShow();
						$("#fileValidationView").show();
						$("#fileValidationViewList").append('<li class="txt_list">'+valTxt+'</li>');
						$("#fileValidationView h1").focus();

						const childInput = $("#fileValidationView").find('a, input:not([type=hidden]), select , button, radio, checkbox, a:not(.closed)');
						var $firstFocusEl = childInput.first();
			            var $lastFocusEl = childInput.last();
			            $lastFocusEl.off('keydown').on({
			                'keydown': function(e) {
			                    var _keyCode = e.keyCode || e.which;
			                    if(_keyCode === 9) {
			                        if(!e.shiftKey) {
			                            e.preventDefault();
			                            $firstFocusEl.focus();
			                        }
			                    }
			                }
			            });
				   }else{
						if($("#fileValidationViewList").length > 0){
							$("#fileValidationViewList").append('<li class="txt_list">'+valTxt+'</li>');
						}else{
							alert(valTxt);
						}
				   }

				   $("#btn_fileValidationViewClose, #btn_fileValidationViewClose").off('click').on('click', function() {
					   var _focus = $("#"+"fileupload_dummy_"+tempId).fileupload("option", "_btn");

						if(!$("div.box_btn_wrap.layer section").hasClass("on")){
							ui.dimHide();
						}
						$("#fileValidationViewList").empty();
				    	$("#fileValidationView").hide();

				    	$("#"+_focus).focus();
				   });
				}

				fileError = false;
//				$(_me.base+ "#div_fileArea").attr("tabindex" , -1).focus();
		    });

			$("#"+"fileupload_dummy_"+tempId).bind('fileuploadprocessalways', function (e, data) {
				ComFileLib.fn_fileSync();
		    });

			$("#"+"fileupload_dummy_"+tempId).bind('fileuploadsubmit', function (e, data) {
				var paramName = data.paramName.replace("files_dummy_", "");
				var sp = paramName.split('_');

				data.formData.id = paramName;
				data.formData.athflMdulId = sp[0];
				data.formData.atchPaprId = sp[1];
		    });
			$("#"+"fileupload_dummy_"+tempId).bind('fileuploaddone', function (e, data) {
		    	log(data,"fileuploaddone");
		    	if(data.textStatus == "success"){
					_me._retUpload.push(data.result.files[0]);
                    _me._retUpload["fieldName"] = _me.fieldName;
					_me._retUpload["athflSeq"] = _me.retAthflSeq;
			    	_me.uploadTmpCnt++;
			    	if(_me.uploadCnt == _me.uploadTmpCnt){
						_me.uploadComplate = "Y";
						if(_me.callback === "Y"){
							_me.uploadFn(_me._retUpload);
						}
					}
				}
		    });

		    $("#"+"fileupload_dummy_"+tempId).bind('fileuploadfail', function (e, data) {
		    	log(data,"fileuploadfail");
		    	if(!typeof data.response === 'undefined'){
					if(data.response()["jqXHR"] != null)
			    	if(typeof data.response().jqXHR === 'undefined'){
					}else{
						alert(data.response().jqXHR.responseJSON.errorMsg);
						return false;
					}
				}
				setTimeout(function(){
					ComFileLib.fn_fileSync();
				}, 10)
		    });
	    }
	};

