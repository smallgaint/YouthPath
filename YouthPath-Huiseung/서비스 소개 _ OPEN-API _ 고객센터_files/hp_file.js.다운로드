					            target.fadeOut(150, function(){
					                $("#popup_atchPaprDiv").remove();
					            })

	//				            if(prevLayerId.length > 0){
	//				                prevLayerId.find("section").fadeIn(150).addClass("on");
	//				            }else{
	//				                ui.dimHide();
	//				            }
					            if(!isDimmed){
									ui.dimHide();
								}
					        });

							e.preventDefault();
						}else{
							data.paramName = "files_dummy_"+fileId+"_"+athflMdulInfo[0].atchPaprId;
						}
					}else{
						data.paramName = "files_dummy_"+fileId;
					}
				}
				, downloadTemplateId : null
