/**
 * 전체파일 삭제 (일반, 공공마이데이터 포함)
 */
ComFileLib.fn_deleteAllFiles = function(_this){
	var _cvplFomtFile = $(_this).data("cvplFomtFile");
	var _selector = $(_this).closest("[id^=filePapr_]");

	if(_selector.length == 0){
		_selector = $(_this).closest("[id^=fileGroup]");
	}

//	var athflMdulId = _id.split("_")[0];
//	var atchPaprId = _id.split("_")[1];

	if(confirm("전체 파일을 삭제하시겠습니까?")) {
		/* 공공마이데이터 삭제 START */
		if(_selector.find('[id^="fileContainer"] ul li.mydata').length > 0){
			_selector.find('[id^="fileContainer"] ul li.mydata').each(function(){
				if($(this).find("[id^=file-cvplRqutRcno]").val() != ""){
					var fileInfo = {"mdtDlngSeq":$(this).find("[id^=file-mdtDlngSeq]").val(), "cvplRqutRcno": $(this).find("[id^=file-cvplRqutRcno]").val(), "athflSeq": $(this).find("[id^=file-athflSeq]").val(), "atchFsno": $(this).find("[id^=file-atchFsno]").val()};

					if(_cvplFomtFile.delImmediate == "N"){
						_cvplFomtFile.delAttachList.push(fileInfo);
					}else{
						ComLib.ajaxReqObj("/cm/z/z/9992/deleteFileForm.do", fileInfo, false);
					}
				}
			});

			_selector.find('[id^="fileContainer"] ul li.mydata').remove();

			$("[id^=addMyData_]").show();
			$("[id^=chkMyData_]").hide();

		}
		/* 공공마이데이터 삭제 END */

		/* 일반 파일 삭제 START */
		_selector.find('[id^="fileContainer_"] li.atchfile').each(function(){
			if($(this).find("[id^=file-ncmnNo]").length > 0){
				var fileInfo = {"ncmnNo": $(this).find("[id^=file-ncmnNo]").val(), "cvplRqutRcno": $(this).find("[id^=file-cvplRqutRcno]").val(), "athflSeq": $(this).find("[id^=file-athflSeq]").val(), "atchFsno": $(this).find("[id^=file-atchFsno]").val()};

				if(_cvplFomtFile.delImmediate == "N"){
					_cvplFomtFile.delAttachList.push(fileInfo);
				}else{
					ComLib.ajaxReqObj("/cm/z/z/9992/deleteFileForm.do", fileInfo, false);
				}

				$(this).closest("ul").empty();
			}else{
				$(this).find("button.delbtn.cancel").trigger("click");
			}
		});
		/* 일반 파일 삭제  END */


		/* 전자증명신청 파일 삭제 START */
		_selector.find('[id^="fileContainer_"] li.elctCrtf').each(function(){
			var d = $(this).find("button[name=btn_del_elct]");

			var spData = $(d).data("seq");
			if(spData != null && spData != ""){
				var sp = $(d).data("seq").split('-');
				if(sp[1] != null && sp[1] != ""){
					var delInfo = {"athflSeq":sp[0], "atchFsno":sp[1],"ecidData.docPackageId":sp[2]};

					if(_cvplFomtFile.delImmediate == "N"){
						_cvplFomtFile.delAttachList.push(delInfo);
					}else{
						ComLib.ajaxReqObj("/cm/z/z/9992/deleteFileEcidForm.do", delInfo, false);
					}
				}
			}
			$(this).remove();
		});

		$(_selector).find("[id^=btn_file_]").each(function(){
			var _id = $(this).attr("id").replace("btn_file_", "");

			$(this).off().on("click", function() {
				$("input[name="+"files_dummy_"+_id+"]").click();
			}).find("span").text("첨부파일 등록");
		});

		$(_selector).find("[id^=btn_reqEcid_]").show();

		//$("[id^='fileupload_dummy_"+_id+"']").fileupload("option", "dropZone", _selector.find("[id^=fileContainer_]"));


//		if(_me.mobileYn == "Y"){
//			$(_me.base+"#"+"btn_"+tempId).on("click", function() {
//				$("input[name="+"files_dummy_"+tempId+"]").click();
//			});
//
//			$(_me.base+"#btn_reqEcid_"+tempId).show();
//		}
//		else{
//			var elctProfDocKndCd = $(d).data("elctprofdockndcd");
//			$(_me.base+"#"+"ecidArea_"+tempId).hide();
//			$(_me.base+"#"+"dropZone_"+tempId).show();
//			$(_me.base+"#chkEcid_"+tempId).attr("disabled",false);
//			$(_me.base+"#chkEcid_"+tempId).attr("checked",false);
//			$(_me.base+"#"+"btn_reqEcid_"+elctProfDocKndCd).hide();
//		}

		/* 전자증명신청 파일 삭제  END */


		ComFileLib.fn_fileSync();
		//첨부파일등록버튼으로 포커스 이동
		fileDelFocus(_this);
	}
}

