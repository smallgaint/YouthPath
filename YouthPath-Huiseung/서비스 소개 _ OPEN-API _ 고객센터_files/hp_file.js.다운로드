			if(ret.athflFnen2 != null && ret.athflFnen2 != ""){
				defaultAcceptFileTypes = ret.athflFnen2;
			}

			var retUrl = "/cm/z/z/9992/fileuploadForAjax.do";
			if(_me.auth == "any"){
				retUrl = "/cm/z/z/9992/fileuploadForAjaxNx.do";
