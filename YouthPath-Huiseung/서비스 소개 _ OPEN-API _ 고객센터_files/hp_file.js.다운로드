	this.addTooltip = function(o){
		$(_me.base).find(".box_tooltip [class*='btn']").attr('aria-expanded', 'false');
		$(_me.base).find(".box_tooltip [class*='btn']").click(function(){
			$lastBtn = $(this);
			var tooltip = $(this).next('.box_help-data').hasClass('active');
			if(tooltip){
				$(this).attr('aria-expanded', 'false').next('.box_help-data').removeClass('active');
			}else{
				$('.btn_help').next('.box_help-data').removeClass('active');
				$(this).attr('aria-expanded', 'true').next('.box_help-data').addClass('active');
			}
		});
		$(_me.base).find('.tooltip_close').click(function(){
			$(this).parent('.box_help-data').removeClass('active').siblings("[class*='btn']").attr('aria-expanded', 'false');
			$lastBtn.focus();
		});


		// 모바일용 툴팁
		$(_me.base).find('.ui-layer').on('click', function() {
			const $this = $(this);
			const myLayer = $(this).next();

			const dimmed = $('.dimmed');
			const thisPoint = $(window).scrollTop();

			// 툴립 속성 추가
			if($this.hasClass('btn_tooltip')) {
				$this.attr('aria-expanded', 'true');
			}

			if (myLayer.length && dimmed.length) {
				myLayer.find('.layer_contents').removeAttr('style');

				if ($this.closest('.popup_full,.popup_allmenu').length > 0) {
					dimmed.css('z-index', '130').show();
					myLayer.css('z-index', '140').show();
				} else {

					dimmed.css('z-index', '130').show();
					myLayer.css('z-index', '140').show().focus();
				}
				util.scrollStop(thisPoint);
				const layerSize = myLayer.outerHeight();
				const gap = (+(myLayer.css('padding-top').replace('px', '')) + +(myLayer.find('.title').innerHeight()));

	            ComLib.cutMobileLayerHidden(myLayer);

				const x = myLayer.find('.layer_close');

				myLayer.find(".title").attr("tabindex", "0").focus();

				const tmAreaSize = myLayer.find('.today_message').length ? $('.today_message').innerHeight() : 0;
				const btnSize = myLayer.find('.btn_group.bottom_btn_group').length ? myLayer.find('.btn_group.bottom_btn_group').innerHeight() : 0;

				myLayer.find('.layer_contents').css('height', ((layerSize - gap) - (tmAreaSize + btnSize)) + 'px');

				x.off('click').on('click', function() {
					$('.btn_tooltip').attr('aria-expanded', 'false'); // 툴립 속성 제거

					myLayer.hide();
					dimmed.hide();

					// 2025.02.06 팝업 중복 스크롤 이슈 수정 - HI
					if ($(".popup_full:visible").length == 0) {
						util.scrollClear(thisPoint);
					}

					$this.focus();
					dimmed.css('z-index', '');
					myLayer.css('z-index', '');
					myLayer.find(".title").removeAttr("tabindex");

					ComLib.cutMobileLayerHidden(myLayer);
				});
			}
		});
	}

